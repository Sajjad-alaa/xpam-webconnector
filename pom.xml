<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.jumpserver</groupId>
    <artifactId>chen</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>backend</module>
    </modules>

    <properties>
        <revision>0.0.1</revision>
        <druid.version>1.2.28-jms-chen.1</druid.version>
        <java.version>21</java.version>
        <maven-compiler-plugin.version>3.9.0</maven-compiler-plugin.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Ship the jar without debug information: no source file names, line numbers or local-variable
             names in the bytecode, so a decompiled jar is far less readable (locals become a1, a2, … and
             stack traces carry no line numbers). Nothing is renamed, so Jackson JSON keys, Spring
             component scanning, WebSocket/gRPC and the reflection-based action framework all keep working.
             Method parameter names are kept on purpose (parameters=true): Spring needs them for the
             unnamed @RequestParam/@PathVariable endpoints. Full name obfuscation (ProGuard) is not
             applied: it would change the JSON API the console depends on and break Spring reflection. -->
        <maven.compiler.debug>false</maven.compiler.debug>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <tomcat.version>10.1.61</tomcat.version>
        <grpc.version>1.75.0</grpc.version>
        <netty.version>4.1.139.Final</netty.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
    </properties>

    <repositories>
        <repository>
            <id>fit2cloud-public</id>
            <name>FIT2CLOUD Public Repository</name>
            <url>https://repository.fit2cloud.com/repository/public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!-- strip debug info (no source file, line numbers, local-variable names), keep
                         method parameter names (Spring needs them for unnamed @RequestParam/@PathVariable) -->
                    <debug>false</debug>
                    <parameters>true</parameters>
                    <!-- debug=false only omits -g (javac still emits line numbers + source file);
                         -g:none removes them all. -parameters (above) is kept for Spring binding. -->
                    <compilerArgs>
                        <arg>-g:none</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.0.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.21.0</version>
        </dependency>
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>0.10.2</version>
        </dependency>
    </dependencies>

</project>
